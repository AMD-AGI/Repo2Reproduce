# ---------------------------------------------------------------------------
# Repo2Reproduce configuration — single source of truth.
# Copy to `.env` and fill in. Anything set here overrides the built-in defaults.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# Option A: public Anthropic API
#   R2R_PROVIDER=anthropic
#   R2R_AUTH_MODE=api_key
#   ANTHROPIC_API_KEY=sk-ant-...
#
# Option B: an Anthropic-format gateway with custom auth headers
#   (e.g. AMD's internal LLM API gateway) — shown below.
R2R_PROVIDER=amd
R2R_AUTH_MODE=custom_headers
R2R_BASE_URL=https://llm-api.amd.com/Unified
R2R_AUTH_HEADERS=Ocp-Apim-Subscription-Key={key}
R2R_AUTH_KEY=<your-gateway-subscription-key>
# R2R_AUTH_USER defaults to $USER; only needed if a header template uses {user}.
# R2R_AUTH_USER=<youruser>

# --- Model (must be an ID the gateway exposes) -----------------------------
R2R_MODEL_REASONING=Claude-Opus-4.8

# --- Paper parsing (OpenDataLoader PDF shells out to java; needs JRE 11+) ---
R2R_JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# --- Optional: where the `claude` engine binary lives (default ~/.local/bin)
# R2R_CLI_BIN_DIR=/home/youruser/.local/bin

# --- Where run directories are created; keep it outside the checkout -------
#     (scripts default to ~/r2r-runs)
# R2R_RUNS_ROOT=/path/to/runs

# --- Run guardrails --------------------------------------------------------
# Each limit applies to every agent session (target, audit, preparation, each repair,
# final report), so a full run can cost several times R2R_MAX_BUDGET_USD.
# --max-budget-usd and --max-turns on the command line override these.
R2R_MAX_BUDGET_USD=100.0
R2R_MAX_TURNS=200
